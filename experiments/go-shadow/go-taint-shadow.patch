new file mode 100644
index 0000000000..d03e1b4a11
--- /dev/null
+++ 2/src/runtime/taint_shadow.go
@@ -0,0 +1,173 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"internal/goarch"
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// taintSourceLabel returns a runtime shadow label for a source value.
+//
+//go:nosplit
+func taintSourceLabel(value string) uint8 {
+	if len(value) == 0 {
+		return 0
+	}
+	return 1
+}
+
+// taintSinkOpen reports a runtime shadow label observed at os.Open.
+//
+//go:nosplit
+func taintSinkOpen(label uint8) {
+	if label == 0 {
+		return
+	}
+	print("taint: os.Open received runtime shadow label\n")
+}
+
+//go:nosplit
+func taintTransitionEnter(targetPC uintptr, label uint8) uintptr {
+	gp := getg()
+	gp.taintTransitionGeneration++
+	if gp.taintTransitionGeneration == 0 {
+		gp.taintTransitionGeneration++
+	}
+	gp.taintTransitionTarget = targetPC
+	gp.taintTransitionReturn = gp.taintTransitionGeneration
+	gp.taintTransitionValues[0] = label
+	return gp.taintTransitionReturn
+}
+
+//go:nosplit
+func taintTransitionTake(selfPC uintptr) (uint8, uintptr) {
+	gp := getg()
+	if gp.taintTransitionTarget != selfPC {
+		return 0, 0
+	}
+	label := gp.taintTransitionValues[0]
+	auth := gp.taintTransitionReturn
+	gp.taintTransitionTarget = 0
+	gp.taintTransitionReturn = 0
+	gp.taintTransitionValues[0] = 0
+	return label, auth
+}
+
+//go:nosplit
+func taintTransitionPublish(auth uintptr, label uint8) {
+	if auth == 0 {
+		return
+	}
+	gp := getg()
+	gp.taintTransitionTarget = auth
+	gp.taintTransitionValues[0] = label
+}
+
+//go:nosplit
+func taintTransitionFinish(auth uintptr) uint8 {
+	gp := getg()
+	label := uint8(0)
+	if auth != 0 && gp.taintTransitionTarget == auth {
+		label = gp.taintTransitionValues[0]
+	}
+	taintTransitionClear()
+	return label
+}
+
+//go:nosplit
+func taintTransitionClear() {
+	gp := getg()
+	gp.taintTransitionTarget = 0
+	gp.taintTransitionReturn = 0
+	gp.taintTransitionValues[0] = 0
+}
+
+func taintStoreString(address unsafe.Pointer, label uint8) {
+	if shadow := taintHeapShadow(address); shadow != nil {
+		atomic.Store8(shadow, label)
+	}
+}
+
+func taintLoadString(address unsafe.Pointer) uint8 {
+	if shadow := taintHeapShadow(address); shadow != nil {
+		return atomic.Load8(shadow)
+	}
+	return 0
+}
+
+//go:linkname taintCopyString
+func taintCopyString(destination, source unsafe.Pointer) {
+	if destination == source {
+		return
+	}
+	taintStoreString(destination, taintLoadString(source))
+}
+
+//go:linkname taintClearString
+func taintClearString(address unsafe.Pointer) {
+	taintStoreString(address, 0)
+}
+
+//go:nosplit
+func taintHeapShadow(address unsafe.Pointer) *uint8 {
+	pointer := uintptr(address)
+	span := spanOf(pointer)
+	if span == nil || pointer < span.base() || pointer >= span.limit {
+		return nil
+	}
+	state := span.state.get()
+	if state != mSpanInUse && state != mSpanManual {
+		return nil
+	}
+	arenaIndex := arenaIndex(pointer)
+	arena := mheap_.arenas[arenaIndex.l1()][arenaIndex.l2()]
+	offset := (pointer - arenaBase(arenaIndex)) / goarch.PtrSize
+	return (*uint8)(add(unsafe.Pointer(arena.taintShadow), offset))
+}
+
+//go:nosplit
+func taintAddressClearRange(base, size uintptr) {
+	for offset := uintptr(0); offset < size; offset += goarch.PtrSize {
+		if shadow := taintHeapShadow(unsafe.Pointer(base + offset)); shadow != nil {
+			atomic.Store8(shadow, 0)
+		}
+	}
+}
+
+//go:nosplit
+func taintAddressCopyRange(destination, source, size uintptr) {
+	for offset := uintptr(0); offset < size; offset += goarch.PtrSize {
+		sourceShadow := taintHeapShadow(unsafe.Pointer(source + offset))
+		destinationShadow := taintHeapShadow(unsafe.Pointer(destination + offset))
+		if destinationShadow == nil {
+			continue
+		}
+		label := uint8(0)
+		if sourceShadow != nil {
+			label = atomic.Load8(sourceShadow)
+		}
+		atomic.Store8(destinationShadow, label)
+	}
+}
+
+//go:nosplit
+func taintHeapClearRange(base, size uintptr) {
+	end := base + size
+	for base < end {
+		arenaIndex := arenaIndex(base)
+		arena := mheap_.arenas[arenaIndex.l1()][arenaIndex.l2()]
+		arenaEnd := arenaBase(arenaIndex) + heapArenaBytes
+		segmentEnd := end
+		if segmentEnd > arenaEnd {
+			segmentEnd = arenaEnd
+		}
+		offset := (base - arenaBase(arenaIndex)) / goarch.PtrSize
+		words := (segmentEnd - base) / goarch.PtrSize
+		memclrNoHeapPointers(add(unsafe.Pointer(arena.taintShadow), offset), words)
+		base = segmentEnd
+	}
+}
