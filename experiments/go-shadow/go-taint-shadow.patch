+func (s *state) taintTrackedType(t *types.Type) bool {
+	return base.Debug.Taint != 0 && !base.Flag.CompilingRuntime && t.IsString()
+}
+
+func (s *state) shadowVariable(n *ir.Name) *ir.Name {
+	shadow := s.shadowVars[n]
+	if shadow != nil {
+		return shadow
+	}
+	shadow = typecheck.TempAt(n.Pos(), s.curfn, types.Types[types.TUINT8])
+	shadow.SetUsed(true)
+	s.shadowVars[n] = shadow
+	return shadow
+}
+
+func (s *state) cleanTaint() *ssa.Value {
+	return s.constInt8(types.Types[types.TUINT8], 0)
+}
+
+func (s *state) shadowFunctionType(t *types.Type) bool {
+	if base.Debug.Taint == 0 || t.NumResults() != 1 || !s.taintTrackedType(t.Result(0).Type) {
+		return false
+	}
+	trackedParams := 0
+	for index := 0; index < t.NumParams(); index++ {
+		if s.taintTrackedType(t.Param(index).Type) {
+			trackedParams++
+		}
+	}
+	return trackedParams == 1
+}
+
+func (s *state) shadowCallable() bool {
+	return s.shadowFunctionType(s.curfn.Type())
+}
+
+func (s *state) shadowFunctionPC() *ssa.Value {
+	return s.entryNewValue1A(ssa.OpAddr, types.Types[types.TUINTPTR], s.curfn.LSym, s.sb)
