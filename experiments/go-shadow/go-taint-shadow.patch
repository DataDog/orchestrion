--- /dev/null
+++ w/src/runtime/taint_shadow.go
@@ -0,0 +1,583 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import (
+	"internal/goarch"
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// taintActive becomes nonzero once a real source has been observed. Copy and
+// conversion hooks consult it to stay cheap in programs that never taint.
+var taintActive uint32
+var taintNextSourceID uint64
+
+type taintRootSet struct {
+	sourceID uint64
+	next     *taintRootSet
+}
+
+// taintSourceString returns a fresh tainted source string with a unique
+// occurrence ID. Only os.Getenv("TAINT_PATH") is treated as a source so
+// unrelated environment reads never taint.
+func taintSourceString(key, value string) (string, uint8) {
+	if key != "TAINT_PATH" || len(value) == 0 {
+		return value, 0
+	}
+	fresh, bytes := rawstring(len(value))
+	copy(bytes, value)
+	sourceID := atomic.Xadd64(&taintNextSourceID, 1)
+	if sourceID == 0 {
+		throw("IAST source ID overflow")
+	}
+	atomic.Store(&taintActive, 1)
+	base := uintptr(unsafe.Pointer(&bytes[0]))
+	taintDataSetRootSet(base, uintptr(len(bytes)), taintNewRootSet(sourceID))
+	return fresh, 1
+}
+
+func taintBytesLabel(value []byte) uint8 {
+	if len(value) == 0 {
+		return 0
+	}
+	data := (*slice)(unsafe.Pointer(&value))
+	if taintDataAny(uintptr(data.array), uintptr(data.len)) {
+		return 1
+	}
+	return 0
+}
+
+func taintMarkDerivedBytes(destination []byte, source string, label uint8) {
+	if len(destination) == 0 {
+		return
+	}
+	sourceBase, sourceLength := taintStringData(source)
+	rootSet, dirty := taintDataRootSet(sourceBase, sourceLength)
+	if label == 0 && !dirty {
+		return
+	}
+	destinationData := (*slice)(unsafe.Pointer(&destination))
+	taintDataSetRootSet(uintptr(destinationData.array), uintptr(destinationData.len), rootSet)
+}
+
+func taintMarkDerivedString(destination, source string) {
+	sourceBase, sourceLength := taintStringData(source)
+	rootSet, dirty := taintDataRootSet(sourceBase, sourceLength)
+	if !dirty {
+		return
+	}
+	destinationBase, destinationLength := taintStringData(destination)
+	taintDataSetRootSet(destinationBase, destinationLength, rootSet)
+}
+
+// taintSinkOpen reports when os.OpenFile receives a tainted value, either via
+// the SSA header label or via any tainted byte in the value's backing data.
+func taintSinkOpen(value string, label uint8) {
+	base, size := taintStringData(value)
+	if label == 0 && !taintDataAny(base, size) {
+		return
+	}
+	print("taint: os.Open received runtime shadow label\n")
+	taintPrintRanges(base, size)
+	taintPrintSourceRanges(base, size)
+}
+
+// taintPrintRanges prints coalesced half-open tainted byte ranges relative to
+// [base, base+size) without allocating.
+func taintPrintRanges(base, size uintptr) {
+	print("taint: os.Open ranges=[")
+	hasRange := false
+	inRange := false
+	start := uintptr(0)
+	for offset := uintptr(0); ; offset++ {
+		dirty := false
+		if offset < size {
+			if shadow, mask := taintShadowBit(base + offset); shadow != nil {
+				dirty = atomic.Load8(shadow)&mask != 0
+			}
+		}
+		if dirty {
+			if !inRange {
+				start = offset
+				inRange = true
+			}
+		} else if inRange {
+			if hasRange {
+				print(",")
+			}
+			print("[", start, ",", offset, "]")
+			hasRange = true
+			inRange = false
+		}
+		if offset == size {
+			break
+		}
+	}
+	print("]\n")
+}
+
+// taintPrintSourceRanges prints coalesced root-set byte ranges relative to
+// [base, base+size) without allocating.
+func taintPrintSourceRanges(base, size uintptr) {
+	print("taint: os.Open sourceRanges=[")
+	hasRange := false
+	inRange := false
+	start := uintptr(0)
+	rootSet := uint64(0)
+	for offset := uintptr(0); ; offset++ {
+		dirty := false
+		currentRootSet := uint64(0)
+		if offset < size {
+			if shadow, mask := taintShadowBit(base + offset); shadow != nil && atomic.Load8(shadow)&mask != 0 {
+				dirty = true
+				if sourceShadow := taintRootSetShadow(base + offset); sourceShadow != nil {
+					currentRootSet = atomic.Load64(sourceShadow)
+				}
+			}
+		}
+		if inRange && (!dirty || currentRootSet != rootSet) {
+			if rootSet == 0 {
+				if hasRange {
+					print(",")
+				}
+				print("[", start, ",", offset, ",0]")
+				hasRange = true
+			} else {
+				for root := taintRootSetFromToken(rootSet); root != nil; root = root.next {
+					if hasRange {
+						print(",")
+					}
+					print("[", start, ",", offset, ",", root.sourceID, "]")
+					hasRange = true
+				}
+			}
+			inRange = false
+		}
+		if dirty && !inRange {
+			start = offset
+			rootSet = currentRootSet
+			inRange = true
+		}
+		if offset == size {
+			break
+		}
+	}
+	print("]\n")
+}
+
+func taintNewRootSet(sourceID uint64) uint64 {
+	root := (*taintRootSet)(persistentalloc(unsafe.Sizeof(taintRootSet{}), unsafe.Alignof(taintRootSet{}), &memstats.gcMiscSys))
+	if root == nil {
+		throw("out of memory allocating IAST root set")
+	}
+	root.sourceID = sourceID
+	return uint64(uintptr(unsafe.Pointer(root)))
+}
+
+func taintRootSetFromToken(token uint64) *taintRootSet {
+	return (*taintRootSet)(unsafe.Pointer(uintptr(token)))
+}
+
+type taintRootSetIterator struct {
+	root      *taintRootSet
+	anonymous bool
+}
+
+func taintRootSetIteratorFor(token uint64) taintRootSetIterator {
+	if token == 0 {
+		return taintRootSetIterator{anonymous: true}
+	}
+	return taintRootSetIterator{root: taintRootSetFromToken(token)}
+}
+
+func (iterator *taintRootSetIterator) current() (uint64, bool) {
+	if iterator.anonymous {
+		return 0, true
+	}
+	if iterator.root == nil {
+		return 0, false
+	}
+	return iterator.root.sourceID, true
+}
+
+func (iterator *taintRootSetIterator) advance() {
+	if iterator.anonymous {
+		iterator.anonymous = false
+		return
+	}
+	iterator.root = iterator.root.next
+}
+
+func taintRootSetMerge(leftToken, rightToken uint64) uint64 {
+	if leftToken == rightToken {
+		return leftToken
+	}
+	left := taintRootSetIteratorFor(leftToken)
+	right := taintRootSetIteratorFor(rightToken)
+	var head, tail *taintRootSet
+	for {
+		leftID, leftOK := left.current()
+		rightID, rightOK := right.current()
+		if !leftOK && !rightOK {
+			break
+		}
+		sourceID := rightID
+		if !rightOK || leftOK && leftID < rightID {
+			sourceID = leftID
+		}
+		if leftOK && leftID == sourceID {
+			left.advance()
+		}
+		if rightOK && rightID == sourceID {
+			right.advance()
+		}
+		root := (*taintRootSet)(persistentalloc(unsafe.Sizeof(taintRootSet{}), unsafe.Alignof(taintRootSet{}), &memstats.gcMiscSys))
+		if root == nil {
+			throw("out of memory merging IAST root sets")
+		}
+		root.sourceID = sourceID
+		if tail == nil {
+			head = root
+		} else {
+			tail.next = root
+		}
+		tail = root
+	}
+	if head == nil || head.next == nil && head.sourceID == 0 {
+		return 0
+	}
+	return uint64(uintptr(unsafe.Pointer(head)))
+}
+
+// taintShadowBit resolves the shadow byte and bit mask for a single heap byte
+// address. The arena shadow stores one bit per application byte: each shadow
+// byte covers one pointer-sized word (8 bytes on 64-bit), matching the
+// per-word allocation exactly.
+//
+//go:nosplit
+func taintShadowBit(pointer uintptr) (*uint8, uint8) {
+	span := spanOf(pointer)
+	if span == nil || pointer < span.base() || pointer >= span.limit {
+		return nil, 0
+	}
+	state := span.state.get()
+	if state != mSpanInUse && state != mSpanManual {
+		return nil, 0
+	}
+	arenaIndex := arenaIndex(pointer)
+	arena := mheap_.arenas[arenaIndex.l1()][arenaIndex.l2()]
+	if arena == nil || arena.taintShadow == nil {
+		return nil, 0
+	}
+	offset := pointer - arenaBase(arenaIndex)
+	word := offset / goarch.PtrSize
+	bit := uint8(offset % goarch.PtrSize)
+	return (*uint8)(add(unsafe.Pointer(arena.taintShadow), word)), uint8(1) << bit
+}
+
+// taintRootSetShadow resolves the source root-set token for a heap byte.
+//
+//go:nosplit
+func taintRootSetShadow(pointer uintptr) *uint64 {
+	span := spanOf(pointer)
+	if span == nil || pointer < span.base() || pointer >= span.limit {
+		return nil
+	}
+	state := span.state.get()
+	if state != mSpanInUse && state != mSpanManual {
+		return nil
+	}
+	arenaIndex := arenaIndex(pointer)
+	arena := mheap_.arenas[arenaIndex.l1()][arenaIndex.l2()]
+	if arena == nil || arena.taintSourceShadow == nil {
+		return nil
+	}
+	offset := pointer - arenaBase(arenaIndex)
+	return (*uint64)(add(unsafe.Pointer(arena.taintSourceShadow), offset*unsafe.Sizeof(uint64(0))))
+}
+
+// taintDataAny reports whether any byte in [base, base+size) is tainted.
+//
+//go:nosplit
+func taintDataAny(base, size uintptr) bool {
+	for offset := uintptr(0); offset < size; offset++ {
+		if shadow, mask := taintShadowBit(base + offset); shadow != nil && atomic.Load8(shadow)&mask != 0 {
+			return true
+		}
+	}
+	return false
+}
+
+func taintDataRootSet(base, size uintptr) (uint64, bool) {
+	rootSet := uint64(0)
+	dirty := false
+	for offset := uintptr(0); offset < size; offset++ {
+		if shadow, mask := taintShadowBit(base + offset); shadow != nil && atomic.Load8(shadow)&mask != 0 {
+			currentRootSet := uint64(0)
+			if sourceShadow := taintRootSetShadow(base + offset); sourceShadow != nil {
+				currentRootSet = atomic.Load64(sourceShadow)
+			}
+			if dirty && rootSet != currentRootSet {
+				rootSet = taintRootSetMerge(rootSet, currentRootSet)
+			} else {
+				rootSet = currentRootSet
+			}
+			dirty = true
+		}
+	}
+	return rootSet, dirty
+}
+
+// taintDataSet taints every byte in [base, base+size).
+//
+//go:nosplit
+func taintDataSet(base, size uintptr) {
+	taintDataSetRootSet(base, size, 0)
+}
+
+//go:nosplit
+func taintDataSetRootSet(base, size uintptr, rootSet uint64) {
+	for offset := uintptr(0); offset < size; offset++ {
+		if shadow, mask := taintShadowBit(base + offset); shadow != nil {
+			atomic.Or8(shadow, mask)
+		}
+		if sourceShadow := taintRootSetShadow(base + offset); sourceShadow != nil {
+			atomic.Store64(sourceShadow, rootSet)
+		}
+	}
+}
+
+// taintDataClear clears every byte in [base, base+size).
+//
+//go:nosplit
+func taintDataClear(base, size uintptr) {
+	for offset := uintptr(0); offset < size; offset++ {
+		if shadow, mask := taintShadowBit(base + offset); shadow != nil {
+			atomic.And8(shadow, ^mask)
+		}
+		if sourceShadow := taintRootSetShadow(base + offset); sourceShadow != nil {
+			atomic.Store64(sourceShadow, 0)
+		}
+	}
+}
+
+// taintDataCopyByte copies one source byte's shadow bit to the destination,
+// overwriting it (including clearing when the source is clean).
+//
+//go:nosplit
+func taintDataCopyByte(destination, source uintptr) {
+	destinationShadow, destinationMask := taintShadowBit(destination)
+	if destinationShadow == nil {
+		return
+	}
+	tainted := false
+	rootSet := uint64(0)
+	if sourceShadow, sourceMask := taintShadowBit(source); sourceShadow != nil {
+		tainted = atomic.Load8(sourceShadow)&sourceMask != 0
+		if tainted {
+			if sourceIDShadow := taintRootSetShadow(source); sourceIDShadow != nil {
+				rootSet = atomic.Load64(sourceIDShadow)
+			}
+		}
+	}
+	if tainted {
+		atomic.Or8(destinationShadow, destinationMask)
+	} else {
+		atomic.And8(destinationShadow, ^destinationMask)
+	}
+	if destinationSourceShadow := taintRootSetShadow(destination); destinationSourceShadow != nil {
+		atomic.Store64(destinationSourceShadow, rootSet)
+	}
+}
+
+// taintDataMove copies shadow bits from source to destination for size bytes,
+// overlap-safe and overwriting (clean source clears the destination).
+//
+//go:nosplit
+func taintDataMove(destination, source, size uintptr) {
+	if atomic.Load(&taintActive) == 0 || size == 0 || destination == source {
+		return
+	}
+	if destination < source {
+		for offset := uintptr(0); offset < size; offset++ {
+			taintDataCopyByte(destination+offset, source+offset)
+		}
+		return
+	}
+	for offset := size; offset > 0; offset-- {
+		taintDataCopyByte(destination+offset-1, source+offset-1)
+	}
+}
+
+// taintClearData clears the shadow for a heap byte range, used by clear().
+//
+//go:nosplit
+func taintClearData(address unsafe.Pointer, size uintptr) {
+	taintDataClear(uintptr(address), size)
+}
+
+// taintStringData returns the backing pointer and length of a string.
+//
+//go:nosplit
+func taintStringData(value string) (uintptr, uintptr) {
+	data := (*stringStruct)(unsafe.Pointer(&value))
+	return uintptr(data.str), uintptr(data.len)
+}
